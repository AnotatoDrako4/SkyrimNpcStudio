<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Test executables run with the UTF-8 process code page (Windows 10 1903+), so argv arrives in UTF-8. CTest passes each
     Catch2 test name on the command line; without this the CRT converts it to the ANSI code page (1252 on the CI runner
     and on Spanish Windows) and names with "—" or accents match no test ("No tests ran"). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
